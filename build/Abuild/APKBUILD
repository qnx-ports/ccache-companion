549c0207048e9920ad025d65a37e4d5227aee78eae98e54c31e6cb2d5a23cbc52c9f903679500e38d29da3a8c4a14b79a8a46b14f948a454bbe40b91efe4dea4  remove-xopen-source-defines.patch
"
