# Alpine-Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Felix Xing <fxing@qnx.com>
pkgname=ccache
pkgver=4.12.1
pkgrel=0
pkgdesc="fast C/C++ compiler cache"
url="https://ccache.dev/"
arch="all"
license="GPL-3.0-or-later"
depends="
    fmt
    libc++
    libxxhash
    qnx-io-sock
    zstd-libs
    "
makedepends="
    cmake
    doctest-dev
    hiredis-dev
    perl
    ninja
    xxhash-dev
    zstd-dev
    clang
    libc++-dev
    fmt-dev
    "
checkdepends="bash python3"
source="https://github.com/ccache/ccache/releases/download/v$pkgver/ccache-$pkgver.tar.xz
        remove-xopen-source-defines.patch
    "
options="!check"

build() {
    cmake -B build -G Ninja \
        -DCMAKE_EXE_LINKER_FLAGS="-lsocket" \
        -DCMAKE_SHARED_LINKER_FLAGS="-lsocket" \
        -DCMAKE_SKIP_RPATH=ON \
        -DCCACHE_DEV_MODE=OFF \
        -DCMAKE_BUILD_TYPE=MinSizeRel \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    local link=
    mkdir -p "$pkgdir"/usr/lib/ccache/bin

    for link in gcc g++ clang clang++ ; do
        ln -sf ../../../bin/ccache "$pkgdir"/usr/lib/ccache/bin/$link
    done
}

sha512sums="
